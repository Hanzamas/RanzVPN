#define	CEDAR_VERSION_MINOR		@PROJECT_VERSION_MINOR@
#define	CEDAR_VERSION_BUILD		@PROJECT_VERSION_PATCH@

#define	BUILDER_NAME			"@BUILD_BUILDER_NAME@"
#define	BUILD_PLACE				"@BUILD_BUILDER_PLACE@"

#define	BUILD_DATE_Y			@BUILD_YEAR@
#define	BUILD_DATE_M			@BUILD_MONTH@
#define	BUILD_DATE_D			@BUILD_DAY@
#define	BUILD_DATE_HO			@BUILD_HOUR@
#define	BUILD_DATE_MI			@BUILD_MINUTE@
#define	BUILD_DATE_SE			@BUILD_SECOND@

#endif	// BUILDINFO_H

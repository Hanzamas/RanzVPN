PREFIX					NULL

# Console system general 
CON_INFILE_ERROR		Error: Tidak dapat membuka file input yang ditentukan "%s".
CON_OUTFILE_ERROR		Error: Tidak dapat membuat file output yang ditentukan "%s".
CON_INFILE_START		Perintah yang tertulis dalam file "%s" akan digunakan sebagai pengganti input dari keyboard.
CON_OUTFILE_START		Pesan yang dikeluarkan ke konsol akan disimpan dalam file "%s".
CON_USER_CANCEL			[EOF]
CON_UNKNOWN_CMD			"%S": Perintah tidak ditemukan. \nAnda dapat menggunakan perintah HELP untuk melihat daftar perintah yang tersedia.
CON_AMBIGUOUS_CMD		"%S": Nama perintah tidak jelas.
CON_AMBIGUOUS_CMD_1		Nama perintah yang ditentukan cocok dengan beberapa perintah.
CON_AMBIGUOUS_CMD_2		Tolong tentukan nama perintah dengan lebih tepat.
CON_INVALID_PARAM		Parameter "/%S" telah ditentukan. Tidak mungkin menentukan parameter ini saat menggunakan perintah "%S". Masukkan "%S /HELP" untuk melihat daftar parameter yang dapat digunakan.
CON_AMBIGUOUS_PARAM		"%S": Nama parameter tidak jelas.
CON_AMBIGUOUS_PARAM_1		Nama parameter yang ditentukan cocok dengan beberapa parameter yang dapat digunakan sebagai parameter perintah "%S".
CON_AMBIGUOUS_PARAM_2		Tolong tentukan nama parameter dengan lebih tepat.


# Unknown command
CMD_UNKNOWM				Tidak ada deskripsi untuk perintah ini.
CMD_UNKNOWN_HELP		Tidak ada deskripsi rinci untuk perintah ini. Jika Anda ingin mengetahui lebih detail tentang perintah ini, silakan merujuk ke manual atau dokumentasi online.
CMD_UNKNOWN_ARGS		Tidak ada contoh eksekusi perintah.
CMD_UNKNOWN_PARAM		Tidak ada deskripsi untuk parameter ini.


# Strings being used within console system
CMD_HELP_1				Anda dapat menggunakan %u perintah berikut:
CMD_HELP_2				Untuk merujuk penggunaan masing-masing perintah, masukkan "nama perintah ?" untuk melihat bantuan.
CMD_EVAL_MIN_MAX		Anda harus menentukan integer dalam rentang dari %u hingga %u untuk nilainya.
CMD_PROMPT				Masukkan nilai: 
CMD_EVAL_NOT_EMPTY		Anda tidak dapat membuat spesifikasi kosong.
CMD_EVAL_SAFE			Rantai ini mengandung karakter yang tidak dapat digunakan.
CMD_EVAL_INT			Anda harus menentukan integer yang tidak kurang dari 1.
CMD_HELP_TITLE			Bantuan untuk perintah "%S"
CMD_HELP_DESCRIPTION	Tujuan:
CMD_HELP_USAGE			Penggunaan:
CMD_HELP_HELP			Deskripsi:
CMD_HELP_ARGS			Parameter:
CMD_PROMPT_PORT			Masukkan nomor port:
CMD_EVAL_PORT			Nomor port tidak valid. Tentukan nomor port yang berada dalam rentang 1 hingga 65535.
CMD_CT_STD_COLUMN_1		Item
CMD_CT_STD_COLUMN_2		Nilai
CMD_CT_STD_COLUMN_3		Deskripsi
CMD_PARSE_IP_SUBNET_ERROR_1	Tentukan dalam format "alamat IPv4/masker subnet". \nTentukan alamat IPv4 dengan memisahkan nilai desimal menggunakan titik seperti "192.168.0.1". Untuk masker subnet, tentukan nilai desimal yang dipisahkan dengan titik seperti "255.255.255.0", atau Anda dapat menentukan panjang bit masker subnet menggunakan nilai desimal seperti 24. \nUntuk menentukan host berdiri sendiri, tentukan masker subnet sebagai "255.255.255.255" atau "32". \n(Contoh)\n 192.168.0.1/24\n 192.168.0.1/255.255.255.0\n192.168.0.5/255.255.255.255\n\n
CMD_PARSE_IP_SUBNET_ERROR_2	Alamat IP yang ditentukan bukan alamat jaringan.
CMD_EVAL_DATE_TIME_FAILED	Spesifikasi tanggal dan waktu tidak valid. \nTanggal dan waktu harus dalam format yang sama dengan "2005/10/08 19:30:00" di mana 6 angka ditentukan, mewakili tahun/bulan/hari jam:menit:detik yang dipisahkan dengan garis miring, sebuah spasi, dan kemudian tanda titik dua. Tentukan 4 digit untuk tahun.
CMD_PARSE_IP_MASK_ERROR_1_6	Tentukan dalam format "alamat IPv6/masker". \nTentukan alamat IPv6 dengan memisahkan nilai heksadesimal menggunakan tanda titik dua seperti "2001:200:0:1::". Untuk masker, tentukan nilai heksadesimal yang dipisahkan dengan titik dua seperti "ffff:ffff:ffff:ffff::", atau Anda dapat menentukan panjang bit masker menggunakan nilai desimal seperti 64. \nUntuk menentukan host berdiri sendiri, tentukan masker sebagai "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff" atau "128". \n(Contoh)\n2001:200:0:1::/64\n2001:200:0:1::/ffff:ffff:ffff:ffff::\n2001:200:0:1::5/12\n\n
CMD_PARSE_IP_MASK_ERROR_1	Tentukan dalam format "alamat IPv4/masker". \nTentukan alamat IPv4 dengan memisahkan nilai desimal menggunakan titik seperti "192.168.0.1". Untuk masker, tentukan nilai desimal yang dipisahkan dengan titik seperti "255.255.255.0", atau Anda dapat menentukan panjang bit masker menggunakan nilai desimal seperti 24. \nUntuk menentukan host berdiri sendiri, tentukan masker sebagai "255.255.255.255" atau "32". \n(Contoh)\n 192.168.0.1/24\n 192.168.0.1/255.255.255.0\n192.168.0.5/255.255.255.255\n\n




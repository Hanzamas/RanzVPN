// Version resource and icon of one executable: ranz_add_executable (cmake/RanzExecutable.cmake)
// fills this template in with configure_file(). English (United States), language 0x0409; the
// strings are Unicode (code page 1200 in the Translation entry).
#pragma code_page(65001)

// LANG_ENGLISH, SUBLANG_ENGLISH_US
LANGUAGE 0x09, 0x01

${RANZ_EXECUTABLE_ICON}

1 VERSIONINFO
 FILEVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},0
 PRODUCTVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},0
 FILEFLAGSMASK 0x17L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hanzcodes"
            VALUE "FileDescription", "${PROJECT_NAME} ${COMPONENT_NAME}"
            VALUE "FileVersion", "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}"
            VALUE "InternalName", "${COMPONENT_INTERNAL_NAME}"
            VALUE "LegalCopyright", "Ranz VPN modifications Copyright (c) 2026 Hanzcodes. Derived from SoftEther VPN: Copyright (c) 2012-${DATE_YEAR} all contributors on SoftEther VPN project in GitHub. Copyright (C) 2004-${DATE_YEAR} Daiyuu Nobori, SoftEther Project at University of Tsukuba, and SoftEther Corporation. All Rights Reserved."
            VALUE "LegalTrademarks", "SoftEther(R) is a registered trademark of SoftEther Corporation in Japan, United States and People's Republic of China. SoftEther Corporation is a company founded at University of Tsukuba, Japan."
            VALUE "OriginalFilename", "${COMPONENT_FILE_NAME}"
            VALUE "ProductName", "${PROJECT_NAME} ${COMPONENT_NAME}"
            VALUE "ProductVersion", "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

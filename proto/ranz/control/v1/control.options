# nanopb options of control.proto: the sizes of the C node's static structures.
#
# Names are DNS labels of at most 63 characters (controller/internal/intent), so 64 bytes hold
# one with its terminating NUL. The counts bound one Update; a node whose state outgrows them
# needs callback fields here, which the node's control stream decides when it lands. An Update of
# 64 objects is larger than 64 kB, so the C build defines PB_FIELD_32BIT.
#
# The controller limits what a node sends it (AUD1-DT-2 #450): the Hello, and each of the Ack,
# Signal, Telemetry and Leases messages, have a largest frame, MaxHello, MaxAck, MaxSignal,
# MaxTelemetry and MaxLeases of controller/internal/control/limits.go, and the controller closes the
# stream of a node that sends a larger one. Each limit is above the largest frame that the sizes of
# the fields of its message allow (Hello and its Capabilities, Signal, Telemetry and the messages
# in it, Leases and Lease), and a test computes those frames from this file: a size that grows
# past its limit fails it, so raise the limit with the size.
ranz.control.v1.NodeConfig.name max_size:64
ranz.control.v1.NodeConfig.tags max_count:16 max_size:64
# One address per L3 Network of a node's VRFs, and a node is in at most 16 VRFs (Peer.vrf_ids)
ranz.control.v1.NodeConfig.addresses max_count:16
# The Mirrors of a node (SDN-23): 16, the most the controller lets one node have
# (controller/internal/intent MaxMirrors)
ranz.control.v1.NodeConfig.mirrors max_count:16
ranz.control.v1.Mirror.name max_size:64
ranz.control.v1.Mirror.sensor max_size:16
ranz.control.v1.Peer.addresses max_count:16
ranz.control.v1.Address.network max_size:64
ranz.control.v1.Vrf.name max_size:64
ranz.control.v1.Network.name max_size:64
ranz.control.v1.Peer.name max_size:64
ranz.control.v1.Peer.public_key max_size:32
ranz.control.v1.Peer.vrf_ids max_count:16
ranz.control.v1.Relay.name max_size:64
ranz.control.v1.Relay.public_key max_size:32
ranz.control.v1.Relay.address max_size:16
ranz.control.v1.Signal.peer max_size:64
ranz.control.v1.Signal.envelope max_size:1024
ranz.control.v1.Prefix.address max_size:16
ranz.control.v1.ObjectKey.name max_size:64
ranz.control.v1.Refuse.message max_size:256
ranz.control.v1.Refuse.leader max_size:256
ranz.control.v1.Update.set max_count:64
ranz.control.v1.Update.remove max_count:64
# A cluster has 3 or 5 members (ADR-0026); an address is host:port of at most 255 characters
# (controller/internal/intent).
ranz.control.v1.Controllers.controllers max_count:8
ranz.control.v1.Controller.name max_size:64
ranz.control.v1.Controller.address max_size:256
ranz.control.v1.Controller.public_key max_size:32
# One Telemetry (SDN-16): a node holds at most 64 objects (Update.set), so it has at most 64 peers,
# and it is in at most 16 VRFs (Peer.vrf_ids) with one rule each until SDN-8 compiles the rules of
# the intent, so 32 rules leave room. A node that has more flow records or events than one message
# holds sends more messages. Names are DNS labels of at most 63 characters.
ranz.control.v1.Telemetry.peers max_count:64
ranz.control.v1.Telemetry.vrfs max_count:16
ranz.control.v1.Telemetry.rules max_count:32
ranz.control.v1.Telemetry.flows max_count:32
ranz.control.v1.Telemetry.events max_count:8
ranz.control.v1.PeerCounters.peer max_size:64
ranz.control.v1.RuleCounters.rule max_size:64
ranz.control.v1.Flow.src max_size:16
ranz.control.v1.Flow.dst max_size:16
ranz.control.v1.NodeEvent.subject max_size:64
ranz.control.v1.NodeEvent.message max_size:256
# The policy of the VRFs (SDN-8): the tags of a peer as those of a node, and 16 values of each kind
# in a Rule, the most the controller lets one Policy have (controller/internal/intent
# MaxPolicyValues). Neither makes an Object larger than a NodeConfig.
ranz.control.v1.Peer.tags max_count:16 max_size:64
ranz.control.v1.Rule.name max_size:64
ranz.control.v1.Rule.ports max_count:16
ranz.control.v1.RuleEnd.tags max_count:16 max_size:64
ranz.control.v1.RuleEnd.prefixes max_count:16
# The 1:1 NAT rules that a node applies, its 4via6 among them, and the routes of a peer, which are
# the outside prefixes of its rules (SDN-6) and the routes that its VRFs leak into the node's
# (SDN-7): 16 each, the most the controller lets one node have (controller/internal/intent
# MaxNATRules and MaxPeerRoutes).
ranz.control.v1.NodeConfig.nat max_count:16
ranz.control.v1.Peer.routes max_count:16
# The DHCP responder of an L2 Network (SDN-43): IPv4 addresses, at most 4 DNS servers and 16
# reservations (controller/internal/intent MaxDHCPServers, MaxDHCPReserved). One Leases message holds
# every lease of one responder, which holds at most 1024 (MaxLeases, NODE_DHCP_MAX_LEASES).
ranz.control.v1.Dhcp.address max_size:4
ranz.control.v1.Dhcp.gateway max_size:4
ranz.control.v1.Dhcp.dns max_count:4 max_size:4
ranz.control.v1.Dhcp.reserved max_count:16
ranz.control.v1.Leases.network max_size:64
ranz.control.v1.Leases.leases max_count:1024
ranz.control.v1.Lease.mac max_size:6
ranz.control.v1.Lease.address max_size:4
ranz.control.v1.Lease.host_name max_size:64
# The security of an L2 Network (SDN-41): 8 gateways at most (controller/internal/intent
# MaxSecurityGateways). It makes a Network about 520 bytes larger, which leaves it smaller than the
# NodeConfig, so an Object is not larger with it.
ranz.control.v1.L2Security.gateways max_count:8 max_size:64
# The Stretch of an L2 Network (SDN-63): at most 8 route targets, each of 21 characters at most (an IPv4 address and a number
# after it, 255.255.255.255:65535), and an ESI of 10 bytes (controller/internal/intent MaxStretchRouteTargets, ESISize). It
# makes a Network about 220 bytes larger, which leaves it smaller than the NodeConfig, so an Object is not larger with it.
ranz.control.v1.Stretch.route_targets max_count:8 max_size:22
ranz.control.v1.Stretch.esi max_size:10
# The zone of overlay DNS in a VRF (SDN-11): a suffix or a name of at most 127 characters, 16
# DnsRecord resources of the VRF and 8 addresses for each (controller/internal/intent MaxDNSName,
# MaxDNSRecords, MaxDNSAddresses). The Vrf object stays smaller than the NodeConfig, so an Object is
# not larger with it.
ranz.control.v1.DnsZone.suffix max_size:128
ranz.control.v1.DnsZone.records max_count:16
ranz.control.v1.DnsRecord.name max_size:128
ranz.control.v1.DnsRecord.addresses max_count:8 max_size:16
# The WireGuard Devices of the VRFs of a node (SDN-80): the IPv4 and the IPv6 address of a Device in
# its Network, its tags as those of a node, the name of its gateway and its WireGuard key; the public
# key of the WireGuard interface of a node in its Capabilities; and the counters of 64 Devices in one
# Telemetry, the most that one gateway terminates (controller/internal/intent MaxGatewayDevices). A
# Device object is smaller than a NodeConfig. Its PresharedKey (SDN-82) is 32 bytes too, and the
# controller sends it to the gateway in clear inside the control stream, never sealed.
ranz.control.v1.Device.name max_size:64
ranz.control.v1.Device.addresses max_count:2
ranz.control.v1.Device.tags max_count:16 max_size:64
ranz.control.v1.Device.gateway max_size:64
ranz.control.v1.Device.public_key max_size:32
ranz.control.v1.Device.preshared_key max_size:32
ranz.control.v1.Capabilities.wireguard_key max_size:32
ranz.control.v1.Telemetry.devices max_count:64
ranz.control.v1.DeviceCounters.device max_size:64
# The Listener of a node (SDN-45): a path of a file on the node of at most 259 characters (MAX_PATH),
# the URL of an ACME directory of at most 255, an e-mail address of at most 127, and 4 DNS names of
# at most 253 characters each (controller/internal/intent MaxListenerPath, MaxListenerURL,
# MaxListenerEmail, MaxACMENames). It makes the NodeConfig, and so an Object, about 1.8 kB larger.
ranz.control.v1.Listener.name max_size:64
ranz.control.v1.Listener.ksp max_size:41
ranz.control.v1.NodeConfig.listener_decoy max_size:48
ranz.control.v1.CertificateFile.path max_size:260
ranz.control.v1.CertificateFile.password_file max_size:260
ranz.control.v1.CertificateAcme.directory max_size:256
ranz.control.v1.CertificateAcme.email max_size:128
ranz.control.v1.CertificateAcme.names max_count:4 max_size:254
ranz.control.v1.CertificateAcme.ca_file max_size:260
# The mimic part of the state of a node (SDN-94): the settings of a mimic server and the links of a client, at most 8
# server names and 8 links (controller/internal/intent MaxMimicServerNames, controller/internal/desired MaxMimicLinks).
# A name is a DNS name of at most 253 characters, an address of at most 255, the path of a file of the node of at most 259
# and an e-mail address of at most 127; a short id is 8 bytes and a key 32. They make the NodeConfig, and so an Object,
# about 9 kB larger.
ranz.control.v1.Mimic.links max_count:8
ranz.control.v1.MimicServer.listen max_size:256
ranz.control.v1.MimicServer.server_names max_count:8 max_size:254
ranz.control.v1.MimicServer.short_id max_size:8
ranz.control.v1.MimicDecoy.dest max_size:256
ranz.control.v1.MimicDecoy.cert_file max_size:260
ranz.control.v1.MimicDecoy.key_file max_size:260
ranz.control.v1.MimicAcme.directory max_size:256
ranz.control.v1.MimicAcme.email max_size:128
ranz.control.v1.MimicAcme.cache_dir max_size:260
ranz.control.v1.MimicAcme.ca_file max_size:260
ranz.control.v1.MimicLink.peer max_size:64
ranz.control.v1.MimicLink.address max_size:256
ranz.control.v1.MimicLink.server_name max_size:254
ranz.control.v1.MimicLink.public_key max_size:32
ranz.control.v1.MimicLink.short_id max_size:8
# What a node reports about itself (SDN-94): the public key of its mimic server, 32 bytes. A Pins frame is 36 bytes at
# most (MaxPins of controller/internal/control).
ranz.control.v1.Pins.mimic_key max_size:32
# The endpoints of a node (SDN-93): 8 at most, as many as the entries of a fallback list (TRANSPORT_MAX_TARGETS), each an
# address of at most 255 characters (controller/internal/intent MaxEndpoints, MaxAddress). They make a Peer about 2.1 kB
# larger, which leaves it smaller than the NodeConfig, and the NodeConfig, and so an Object, about 2.1 kB larger.
ranz.control.v1.Peer.endpoints max_count:8
ranz.control.v1.NodeConfig.endpoints max_count:8
ranz.control.v1.Endpoint.address max_size:256
# The TLS fingerprints of the certificate of the controller that a node accepts (SDN-92): 64 hex
# digits each, and at most 4, the certificate in use, the one that comes next, and room for a
# controller that gives more. It makes the NodeConfig, and so an Object, about 260 bytes larger.
ranz.control.v1.NodeConfig.controller_tls max_count:4 max_size:65
# The tunnel endpoint of a node for the links of kind vxlan and geneve (SDN-76): an IPv4 or an IPv6
# address. It makes a Peer and the NodeConfig about 30 bytes larger.
ranz.control.v1.Vtep.address max_size:16
# The live operations (SDN-50): an Operation names an L2 Network, a DNS label of at most 63 characters, and one MAC
# address or one IP address. The OperationResult of a node holds at most 512 entries of a table, each with a MAC address,
# an address and the name of the member, and why an operation failed. It is a frame of at most 57 kB, below
# MaxOperationResult, and smaller than an Update.
ranz.control.v1.Operation.network max_size:64
ranz.control.v1.Operation.mac max_size:6
ranz.control.v1.Operation.address max_size:16
ranz.control.v1.OperationResult.message max_size:256
ranz.control.v1.OperationResult.entries max_count:512
ranz.control.v1.TableEntry.mac max_size:6
ranz.control.v1.TableEntry.address max_size:16
ranz.control.v1.TableEntry.member max_size:64
# The topology of a VRF and its gateways (SDN-19): the name of the hub node of a VRF of topology
# hub-and-spoke, and the LAN subnets behind a node, 16 at most (controller/internal/intent
# MaxLANSubnets). They make a Vrf object about 70 bytes larger and the NodeConfig about 500 bytes.
ranz.control.v1.Vrf.hub max_size:64
ranz.control.v1.NodeConfig.lan_subnets max_count:16
# The session profile of a device (SDN-40): the names of the SessionProfile and of the User that owns
# the device, DNS labels as every name. It makes a Peer and the NodeConfig, and so an Object, about 200
# bytes larger.
ranz.control.v1.SessionProfile.name max_size:64
ranz.control.v1.SessionProfile.user max_size:64
# The VRFs whose internet exit a node is (SDN-12): at most 16, the VRFs of a node (Peer.vrf_ids). It
# makes the NodeConfig, and so an Object, about 70 bytes larger.
ranz.control.v1.NodeConfig.egress_vrf_ids max_count:16
# The BGP peering of the standard mode (SDN-77): a router id, the addresses of the sidecars, the LAN
# subnets that a node announces, 16 at most, and what a peer may announce, its 16 addresses at most
# and its LAN subnets (controller/internal/intent MaxPeeringAnnounce, MaxPeeringAccept). They make
# the NodeConfig about 700 bytes larger and a Peer about 1.4 kB, which leaves it smaller than the
# NodeConfig.
ranz.control.v1.NodePeering.router_id max_size:4
ranz.control.v1.NodePeering.address max_size:16
ranz.control.v1.NodePeering.announce max_count:16
ranz.control.v1.PeerPeering.address max_size:16
ranz.control.v1.PeerPeering.vrf_ids max_count:16
ranz.control.v1.PeerPeering.accept max_count:32
# What a node reports of the peering in its Telemetry (SDN-77): the peers of its sidecar, at most one
# for each of its 64 Peer objects, each with the address of its sidecar, the state of its session,
# a word of at most 11 letters, and the prefixes that the node learned from it, at most what the
# peer may announce (PeerPeering.accept). They make the largest Telemetry frame about 84 kB larger
# (MaxTelemetry).
ranz.control.v1.PeeringReport.peers max_count:64
ranz.control.v1.PeeringPeer.address max_size:16
ranz.control.v1.PeeringPeer.state max_size:16
ranz.control.v1.PeeringPeer.learned max_count:32

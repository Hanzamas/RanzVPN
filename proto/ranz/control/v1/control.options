# nanopb options of control.proto: the sizes of the C node's static structures.
#
# Names are DNS labels of at most 63 characters (controller/internal/intent), so 64 bytes hold
# one with its terminating NUL. The counts bound one Update; a node whose state outgrows them
# needs callback fields here, which the node's control stream decides when it lands. An Update of
# 64 objects is larger than 64 kB, so the C build defines PB_FIELD_32BIT.
ranz.control.v1.NodeConfig.name max_size:64
ranz.control.v1.NodeConfig.tags max_count:16 max_size:64
# One address per L3 Network of a node's VRFs, and a node is in at most 16 VRFs (Peer.vrf_ids)
ranz.control.v1.NodeConfig.addresses max_count:16
ranz.control.v1.Peer.addresses max_count:16
ranz.control.v1.Address.network max_size:64
ranz.control.v1.Vrf.name max_size:64
ranz.control.v1.Network.name max_size:64
ranz.control.v1.Peer.name max_size:64
ranz.control.v1.Peer.public_key max_size:32
ranz.control.v1.Peer.vrf_ids max_count:16
ranz.control.v1.Relay.name max_size:64
ranz.control.v1.Relay.public_key max_size:32
ranz.control.v1.Relay.address max_size:16
ranz.control.v1.Signal.peer max_size:64
ranz.control.v1.Signal.envelope max_size:1024
ranz.control.v1.Prefix.address max_size:16
ranz.control.v1.ObjectKey.name max_size:64
ranz.control.v1.Refuse.message max_size:256
ranz.control.v1.Refuse.leader max_size:256
ranz.control.v1.Update.set max_count:64
ranz.control.v1.Update.remove max_count:64
# A cluster has 3 or 5 members (ADR-0026); an address is host:port of at most 255 characters
# (controller/internal/intent).
ranz.control.v1.Controllers.controllers max_count:8
ranz.control.v1.Controller.name max_size:64
ranz.control.v1.Controller.address max_size:256
ranz.control.v1.Controller.public_key max_size:32
# One Telemetry (SDN-16): a node holds at most 64 objects (Update.set), so it has at most 64 peers,
# and it is in at most 16 VRFs (Peer.vrf_ids) with one rule each until SDN-8 compiles the rules of
# the intent, so 32 rules leave room. A node that has more flow records or events than one message
# holds sends more messages. Names are DNS labels of at most 63 characters.
ranz.control.v1.Telemetry.peers max_count:64
ranz.control.v1.Telemetry.vrfs max_count:16
ranz.control.v1.Telemetry.rules max_count:32
ranz.control.v1.Telemetry.flows max_count:32
ranz.control.v1.Telemetry.events max_count:8
ranz.control.v1.PeerCounters.peer max_size:64
ranz.control.v1.RuleCounters.rule max_size:64
ranz.control.v1.Flow.src max_size:16
ranz.control.v1.Flow.dst max_size:16
ranz.control.v1.NodeEvent.subject max_size:64
ranz.control.v1.NodeEvent.message max_size:256
# The DHCP responder of an L2 Network (SDN-43): IPv4 addresses, at most 4 DNS servers and 16
# reservations (controller/internal/intent MaxDHCPServers, MaxDHCPReserved). One Leases message holds
# every lease of one responder, which holds at most 1024 (MaxLeases, NODE_DHCP_MAX_LEASES).
ranz.control.v1.Dhcp.address max_size:4
ranz.control.v1.Dhcp.gateway max_size:4
ranz.control.v1.Dhcp.dns max_count:4 max_size:4
ranz.control.v1.Dhcp.reserved max_count:16
ranz.control.v1.Leases.network max_size:64
ranz.control.v1.Leases.leases max_count:1024
ranz.control.v1.Lease.mac max_size:6
ranz.control.v1.Lease.address max_size:4
ranz.control.v1.Lease.host_name max_size:64

# Software Configuration File
# ---------------------------
#
# The sample Config file of the import of ranz_server.config into intent (SDN-27 #203; forkimport, ranz import-config): the
# two Virtual Hubs of the fixture of vpntest "policyimport" (CORE-S4-3 #76), written as Cfg writes them, with the items at
# their defaults left out. LAB has the access list, the groups and the VLAN policies of the fixture, an entry of each kind
# that a Policy can carry and each kind that it cannot (a MAC address, a source port, the TCP state, a redirect URL, a
# delay, a user list file, a mask that is no prefix, an entry that is inactive and one that matches nothing); OFFICE has no
# access list. The verdicts that the fork gave the frames of LAB are the ones that tests/golden/policyimport records.
#
declare root
{
	uint ConfigRevision 1

	declare ListenerList
	{
	}
	declare ServerConfiguration
	{
		bool DontBackupConfig true
	}
	declare VirtualHUB
	{
		declare LAB
		{
			bool Online true

			declare AccessList
			{
				declare 1
				{
					bool Active true
					string DestIpAddress 10.0.0.10
					uint DestPortEnd 22
					uint DestPortStart 22
					string DestSubnetMask 255.255.255.255
					bool Discard true
					string Note no$20ssh$20to$20the$20server
					uint Priority 100
					uint Protocol 6
				}
				declare 2
				{
					bool Active true
					uint DestPortEnd 22
					uint DestPortStart 22
					bool Discard false
					string Note alice$20may
					uint Priority 100
					uint Protocol 6
					string SrcUsername alice
				}
				declare 3
				{
					bool Active true
					string DestIpAddress 10.0.0.0
					string DestSubnetMask 255.255.255.0
					bool Discard true
					uint Priority 200
					string SrcUsername guests
				}
				declare 4
				{
					bool Active true
					bool Discard false
					uint Priority 300
					string SrcUsername ops
				}
				declare 5
				{
					bool Active true
					bool CheckSrcMac true
					uint DestPortEnd 80
					uint DestPortStart 80
					bool Discard false
					uint Priority 500
					uint Protocol 6
					string SrcMacAddress 02-00-00-4C-00-03
					string SrcMacMask FF-FF-FF-FF-FF-FF
				}
				declare 6
				{
					bool Active true
					string DestIpAddress6 2001:db8:1::
					string DestSubnetMask6 ffff:ffff:ffff::
					bool Discard true
					bool IsIPv6 true
					uint Priority 600
					uint Protocol 58
				}
				declare 7
				{
					bool Active true
					string DestIpAddress 172.16.9.1
					string DestSubnetMask 255.255.0.255
					bool Discard true
					uint Priority 700
				}
				declare 8
				{
					bool Active true
					uint DestPortEnd 8080
					uint DestPortStart 8000
					bool Discard false
					uint Priority 800
				}
				declare 9
				{
					bool Active true
					bool Discard true
					uint Priority 850
					uint Protocol 17
					uint SrcPortEnd 53
					uint SrcPortStart 53
				}
				declare 10
				{
					bool Active false
					bool Discard true
					uint Priority 900
					uint Protocol 1
				}
				declare 11
				{
					bool Active true
					uint DestPortEnd 80
					uint DestPortStart 80
					bool Discard false
					uint Priority 1000
					uint Protocol 6
					string RedirectUrl http://portal.example/login
				}
				declare 12
				{
					bool Active true
					uint Delay 10
					uint DestPortEnd 5060
					uint DestPortStart 5060
					bool Discard false
					uint Jitter 5
					uint Priority 1100
					uint Protocol 17
				}
				declare 13
				{
					bool Active true
					bool CheckTcpState true
					bool Discard true
					bool Established false
					uint Priority 1200
					uint Protocol 6
				}
				declare 14
				{
					bool Active true
					string DestUsername carol
					bool Discard true
					uint Priority 1300
					uint Protocol 1
				}
				declare 15
				{
					bool Active true
					string DestIpAddress 10.0.5.0
					string DestSubnetMask 255.255.255.0
					bool Discard true
					uint Priority 1400
					string SrcUsername include:blocked.txt
				}
				declare 16
				{
					bool Active true
					uint DestPortEnd 80
					uint DestPortStart 80
					bool Discard true
					uint Priority 1500
					uint Protocol 1
				}
			}
			declare Option
			{
				bool NoArpPolling true
				bool NoIPv6AddrPolling true
			}
			declare SecurityAccountDatabase
			{
				declare GroupList
				{
					declare guests
					{
						string Note $
						string RealName Guests

						declare Policy
						{
							bool Access true
							uint VLanId 20
						}
					}
					declare ops
					{
						string Note $
						string RealName Operations

						declare Policy
						{
							bool Access true
							uint VLanId 1
						}
					}
					declare staff
					{
						string Note $
						string RealName Staff

						declare Policy
						{
							bool Access true
							uint VLanId 10
						}
					}
				}
				declare UserList
				{
					declare alice
					{
						uint AuthType 0
						string GroupName staff
					}
					declare bob
					{
						uint AuthType 0
						string GroupName staff

						declare Policy
						{
							bool Access true
						}
					}
					declare carol
					{
						uint AuthType 0
					}
					declare dave
					{
						uint AuthType 0
						string GroupName ops
					}
					declare erin
					{
						uint AuthType 0
						string GroupName guests
					}
					declare frank
					{
						uint AuthType 0
						string GroupName guests

						declare Policy
						{
							bool Access true
							uint VLanId 10
						}
					}
					declare ops
					{
						uint AuthType 0
					}
					declare srv
					{
						uint AuthType 0
					}
				}
			}
		}
		declare OFFICE
		{
			bool Online true

			declare Option
			{
				bool NoArpPolling true
				bool NoIPv6AddrPolling true
				string VlanTypeId 0x88a8
			}
			declare SecurityAccountDatabase
			{
				declare UserList
				{
					declare kim
					{
						uint AuthType 0

						declare Policy
						{
							bool Access true
							uint VLanId 30
						}
					}
					declare lee
					{
						uint AuthType 0
					}
					declare max
					{
						uint AuthType 0
					}
				}
			}
		}
	}
}

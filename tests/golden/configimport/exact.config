# Software Configuration File
# ---------------------------
#
# The Config file of the Virtual Hub EXACT (SDN-27 #203; forkimport, ranz import-config): every entry of its access list is
# one that a Policy carries as it stands, so the import judges each frame as the fork does. The entries name a group, a
# user that is in no group and a user of the name of a group; two of them share a priority, one that passes and one that
# discards; they have prefixes, the ports of TCP, of UDP, and of an entry that names no protocol, a protocol alone, and one
# that is inactive. The users are in the groups red and blue.
# The scenario forkimport-exact of tests/explain runs frames through the data plane of real Nodes, and the test
# TestForkImportJudgesEveryFrameAsTheForkDid of controller/internal/explain holds the import to the access list of the fork
# for every frame between two Nodes. The other Config file of the import, sample.config, has the entries that a Policy cannot
# carry as they stand.
#
declare root
{
	declare ServerConfiguration
	{
	}
	declare VirtualHUB
	{
		declare EXACT
		{
			declare AccessList
			{
				declare 1
				{
					bool Active true
					bool Discard false
					uint DestPortEnd 22
					uint DestPortStart 22
					uint Priority 100
					uint Protocol 6
					string SrcUsername red
				}
				declare 2
				{
					bool Active true
					bool Discard true
					uint DestPortEnd 22
					uint DestPortStart 22
					uint Priority 100
					uint Protocol 6
				}
				declare 3
				{
					bool Active true
					string DestUsername blue
					bool Discard true
					uint Priority 200
					string SrcIpAddress 10.9.0.4
					string SrcSubnetMask 255.255.255.255
				}
				declare 4
				{
					bool Active true
					bool Discard false
					uint DestPortEnd 5100
					uint DestPortStart 5000
					uint Priority 300
					uint Protocol 17
					string SrcUsername u3
				}
				declare 5
				{
					bool Active true
					bool Discard true
					uint Priority 400
					uint Protocol 17
				}
				declare 6
				{
					bool Active true
					string DestIpAddress 10.9.0.2
					string DestSubnetMask 255.255.255.255
					bool Discard true
					uint Priority 500
					uint Protocol 1
				}
				declare 7
				{
					bool Active true
					bool Discard false
					uint DestPortEnd 8100
					uint DestPortStart 8000
					uint Priority 600
					uint Protocol 6
					string SrcUsername red
				}
				declare 8
				{
					bool Active true
					bool Discard true
					uint DestPortEnd 8081
					uint DestPortStart 8081
					uint Priority 700
				}
				declare 9
				{
					bool Active false
					bool Discard true
					uint Priority 800
					uint Protocol 6
				}
			}
			declare SecurityAccountDatabase
			{
				declare GroupList
				{
					declare blue
					{
					}
					declare red
					{
					}
				}
				declare UserList
				{
					declare blue
					{
					}
					declare u1
					{
						string GroupName red
					}
					declare u2
					{
						string GroupName red
					}
					declare u3
					{
						string GroupName blue
					}
					declare u4
					{
					}
				}
			}
		}
	}
}

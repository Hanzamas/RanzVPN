(* settings-fast.pvl
   The settings of ProVerif for the variants that leak keys (AUD-5, #389), which are the ones of the Noise Explorer for
   its models: an if on a term stays a term of the clauses and does not copy the rest of the process for each of its
   branches, and the trace of an attack is not rebuilt, since the rebuilding of a trace through the Diffie-Hellman
   equation takes more of a runner than it has. The derivation of an attack, from what the attacker knows to the event
   that must not happen, is in the log of ProVerif, and ProVerif then says that the query cannot be proved.
*)

set expandIfTermsToTerms = true.
set traceBacktracking = false.
set reconstructTrace = false.

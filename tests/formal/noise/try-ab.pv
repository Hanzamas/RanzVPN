(* try-ab.pv: a try (AUD-5, #389). Noise_IK cut after its second message. *)

process
  ( NoiseSetup()
  | NoiseLeaks(alice)
  | NoiseLeaks(bob)
  | !( new sid: sessionid; NoiseInitAB(alice, bob, sid) )
  | !( new sid: sessionid; NoiseInitAB(alice, charlie, sid) )
  | !( new sid: sessionid; NoiseRespAB(bob, alice, sid) )
  | !( new sid: sessionid; NoiseRespAB(bob, charlie, sid) )
  )

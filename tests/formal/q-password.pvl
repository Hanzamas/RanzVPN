(* q-password.pvl
   The secrecy query of the password of the Login (AUD-6, #409). Only the session models with a Login have it: the
   control stream carries no password (the controller knows a node by its static key alone), and an overlay session has
   no Login. *)

(* The password of alice, which the client sends in its first control record once the handshake is complete *)
(* @query sec-pw *)
query attacker(pw(alice)).

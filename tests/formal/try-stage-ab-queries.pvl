(* try-stage-ab-queries.pvl: a try (AUD-5, #389). Queries of the second message of Noise_IK. *)

(* @query reach-b *)
query m: bitstring; event(RecvMsg(alice, bob, st_b, m)).

(* @query b-auth2 *)
query cc: principal, m: bitstring; event(RecvMsg(alice, bob, st_b, m)) ==> event(SendMsg(bob, cc, st_b, m)) || event(LeakS(phase0, bob)).

(* @query b-conf2 *)
query sid: sessionid, px: phasen; attacker(msg_b(bob, alice, sid)) ==> event(LeakS(px, alice)).

(* Variant tls443-p0: the session handshake over TLS 1.3 on TCP 443, as the code has it (AUD-5, #389), with the
   keys of alice and bob and the key of the certificate of bob leaked in phase 0 only: there is no phase 1, so
   the model has the attacker of the sessions and nothing for the forward secrecy. *)

process
  ( Setup()
  | LeaksP0()
  | !( Client(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

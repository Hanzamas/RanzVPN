(* Negative control tls443-nobinding: tls443 with the binding left out of the prologue (AUD-5, #389). The
   pin still keeps a middlebox out unless it holds the key of the certificate of bob, so the attack that
   this variant must show is the one with that key leaked and nothing else: the binding is what stops a
   holder of the certificate key, and without it the handshake of alice is relayed to bob over a second TLS
   session. The queries that hold in tls443 and fail here are the proof that the binding does that work. *)

process
  ( Setup()
  | Leaks()
  | !( Client(alice, bob, pin_on, bt_none, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_none, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_none, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

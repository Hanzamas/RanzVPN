(* Variant control-go-noise: the control stream of a Go client to the controller, against an attacker that holds the Noise
   identity key of the controller (AUD-5, #389). The client checks no certificate, so the static key of the controller is
   the only secret that it relies on, and its holder answers the client in a TLS session of its own: finding C1. This is
   nopin-noise with the labels of the control stream. *)

process
  ( Setup()
  | LeakNoiseServer()
  | Sessions(pin_off, bt_export, plabel_control, lab_exp_control, suite_ik)
  )

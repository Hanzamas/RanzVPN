(* Variant tls443: the session handshake over TLS 1.3 on TCP 443, as the code has it (AUD-5, #389).
   The client pins the certificate of the server (TlsCheckPin) and the Noise handshake is bound to the TLS
   exporter of label NOISE_EXPORTER_LABEL (TlsExporter, NOISE_BINDING_EXPORTER). The keys of alice and of bob,
   and the key of the certificate of bob, are leaked in phase 0 and in phase 1. *)

process
  ( Setup()
  | Leaks()
  | !( Client(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, suite_hfs, sid) )
  )

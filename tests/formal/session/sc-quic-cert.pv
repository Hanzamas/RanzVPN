(* Scenario quic-cert: the session over QUIC, as the code has it, and an attacker that holds the key of the certificate of
   the server (AUD-5, #389). msquic gives no TLS exporter, so the binding is the tls-server-end-point of RFC 5929
   (QuicCertBinding, NOISE_BINDING_SERVER_END_POINT), the same for every connection to the certificate. *)

process
  ( Setup()
  | LeakCertServer()
  | !( Client(alice, bob, pin_on, bt_endpoint, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_endpoint, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_endpoint, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

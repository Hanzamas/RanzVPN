(* Scenario nopin-noise: negative control, the session over TLS 1.3 with the client that pins no certificate, and an
   attacker that holds the Noise identity key of the server (AUD-5, #389). The pin is what stops the holder of that
   key from answering the client in a TLS session of its own. *)

process
  ( Setup()
  | LeakNoiseServer()
  | !( Client(alice, bob, pin_off, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

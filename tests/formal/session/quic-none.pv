(* Variant quic-none: the session handshake over QUIC, as the code has it, against an attacker that is the network and
   nothing more (AUD-5, #389; AUD-6, #409; CORE-H5, #408). The binding is the TLS exporter of the QUIC connection, which
   msquic gives from 2.6 on (TransportQuicExporter, NOISE_BINDING_EXPORTER), as on TLS-443. The client pins the
   certificate (QuicConnCallback). *)

process
  ( Setup()
  | Sessions(pin_on, bt_export, bt_export, kp_on, plabel_session, lab_exp_session, suite_hfs)
  )

(* Variant quic-honest: the QUIC path with no key leaked (AUD-5, #389). *)

process
  ( Setup()
  | !( Client(alice, bob, pin_on, bt_endpoint, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_endpoint, plabel_session, lab_exp_session, suite_ik, suite_hfs, sid) )
  )

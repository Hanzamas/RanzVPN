(* Variant tls443-cert-client: the session handshake over TLS 1.3 on TCP 443, as the code has it, against an attacker
   that holds the key of the certificate of the server and the Noise identity key of the client (AUD-5, #389; AUD-6,
   #409). The client's key lets it start handshakes as the client (the first message of Noise_IK is open to the
   compromise of the key of its initiator), and without the password it cannot log in, and it still cannot be the
   server. *)

process
  ( Setup()
  | LeakCertServer()
  | LeakNoiseClient()
  | Sessions(pin_on, bt_export, bt_export, kp_on, plabel_session, lab_exp_session, suite_hfs)
  )

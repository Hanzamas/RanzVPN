(* Variant quic-fs: the session handshake over QUIC, as the code has it, against an attacker that holds every long-term
   key of the nodes after the sessions (AUD-5, #389). As tls443-fs. *)

process
  ( Setup()
  | LeakLate()
  | !( Client(alice, bob, pin_on, bt_endpoint, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_endpoint, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

(* Negative control nobinding-cert: the session handshake over TLS 1.3 with the binding left out of the prologue, against an
   attacker that holds the key of the certificate of the server (AUD-5, #389). It is tls443-cert with no binding. The
   binding is what stops a holder of that key, and without it the handshake of alice is relayed to bob over a second TLS
   session, so the queries that hold in tls443-cert must fail here. CI fails when they do not. *)

process
  ( Setup()
  | LeakCertServer()
  | Sessions(pin_on, bt_none, plabel_session, lab_exp_session, suite_hfs)
  )

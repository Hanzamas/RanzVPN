(* Scenario none: the session over TLS 1.3 on TCP 443, as the code has it, and an attacker that is the network and
   nothing more (AUD-5, #389). The client pins the certificate of the server (TlsCheckPin) and the Noise handshake
   is bound to the TLS exporter (TlsExporter, NOISE_BINDING_EXPORTER). *)

process
  ( Setup()
  | !( Client(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

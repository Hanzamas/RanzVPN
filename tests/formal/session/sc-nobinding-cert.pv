(* Scenario nobinding-cert: negative control, the session over TLS 1.3 with the binding left out of the prologue, and an
   attacker that holds the key of the certificate of the server (AUD-5, #389). The binding is what stops a holder of
   that key, and without it the handshake of alice is relayed to bob over a second TLS session. *)

process
  ( Setup()
  | LeakCertServer()
  | !( Client(alice, bob, pin_on, bt_none, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_none, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_none, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

(* Variant control-node: the control stream of a C node to the controller (AUD-5, #389; Control.c,
   ControlRun). The node is alice and the controller is bob. The TLS transport of the node pins the
   certificate of the controller (TlsCheckPin), the Noise_IK handshake of the node with the pinned static key
   of the controller is bound to the exporter of CONTROL_EXPORTER_LABEL in the prologue CONTROL_PROLOGUE_LABEL,
   and the suite is Noise_IK only. What the node sends in its first record stands for its Hello and its
   Telemetry, the answer for the Update. *)

process
  ( Setup()
  | Leaks()
  | !( Client(alice, bob, pin_on, bt_export, plabel_control, lab_exp_control, suite_ik) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_control, lab_exp_control, suite_ik, suite_ik, sid) )
  )

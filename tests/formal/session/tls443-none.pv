(* Variant tls443-none: the session handshake over TLS 1.3 on TCP 443, as the code has it, against an attacker that is
   the network and nothing more (AUD-5, #389). The client pins the certificate of the server (TlsCheckPin) and the Noise
   handshake is bound to the TLS exporter of label NOISE_EXPORTER_LABEL (TlsExporter, NOISE_BINDING_EXPORTER). *)

process
  ( Setup()
  | Sessions(pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs)
  )

(* Variant tls443-none: the session handshake over TLS 1.3 on TCP 443, as the code has it, against an attacker that is
   the network and nothing more (AUD-5, #389; AUD-6, #409). The client pins the certificate of the server (TlsCheckPin)
   and the Noise handshake is bound to the TLS exporter of label NOISE_EXPORTER_LABEL (TlsExporter,
   NOISE_BINDING_EXPORTER). The server takes the key of any initiator and compares it with the key pinned to the user
   after the Login. *)

process
  ( Setup()
  | Sessions(pin_on, bt_export, bt_export, kp_on, plabel_session, lab_exp_session, suite_hfs)
  )

(* Negative control tls443-nopin: tls443 with the pin left out, so the client accepts any certificate (AUD-5,
   #389). The binding still stops a middlebox from relaying the handshake, so the attack that this variant
   must show is the one with the Noise identity key of bob leaked and nothing else: the pin is what stops
   the holder of that key from answering the client in a TLS session of its own. The queries that hold in
   tls443 and fail here are the proof that the pin does that work. *)

process
  ( Setup()
  | Leaks()
  | !( Client(alice, bob, pin_off, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, sid) )
  | !( new sid: sessionid; Server(bob, alice, bt_export, plabel_session, lab_exp_session, suite_hfs, sid) )
  )

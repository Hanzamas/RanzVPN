(* Variant tls443-noise-client: the session handshake over TLS 1.3 on TCP 443, as the code has it, against an attacker
   that holds the Noise identity keys of the server and of the client but not the key of the certificate (AUD-5, #389).
   The pin is what must keep it from answering the client in a TLS session of its own. *)

process
  ( Setup()
  | LeakNoiseServer()
  | LeakNoiseClient()
  | Sessions(pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs)
  )

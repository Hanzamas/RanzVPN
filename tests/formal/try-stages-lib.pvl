(* try-stages-lib.pvl: a try (AUD-5, #389). Noise_IK cut after its first message (NoiseInitA, NoiseRespA) and after
   its second (NoiseInitAB, NoiseRespAB), to see at which message ProVerif slows down. The constants and the events
   are the ones of noise-lib.pvl, which a variant joins before this file. *)

let NoiseInitA(me: principal, them: principal, sid: sessionid) =
  new e: bitstring;
  let sI = skey(me) in
  let SI = pk(sI) in
  let SR = spub(them) in
  let E = pk(e) in
  let h0 = hash1(proto_ik) in
  let h1 = mixh(mixh(h0, prol_enc), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k1 = hkk(h0, dhi(e, SR)) in
  let cs = aead(k1, h2, SI) in
  let h3 = mixh(h2, cs) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  let ma = msg_a(me, them, sid) in
  let cp = aead(k2, h3, ma) in
  event SendMsg(me, them, st_a, ma);
  out(c, (E, cs, cp)).

let NoiseRespA(me: principal, them: principal, sid: sessionid) =
  in(c, (E: bitstring, cs: bitstring, cp: bitstring));
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(proto_ik) in
  let h1 = mixh(mixh(h0, prol_enc), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k1 = hkk(h0, dhr(sR, E)) in
  if unaead(k1, h2, cs) = spub(them) then
  let SI = spub(them) in
  let h3 = mixh(h2, cs) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let ma = unaead(k2, h3, cp) in
  event RecvMsg(me, them, st_a, ma).

let NoiseInitAB(me: principal, them: principal, sid: sessionid) =
  new e: bitstring;
  let sI = skey(me) in
  let SI = pk(sI) in
  let SR = spub(them) in
  let E = pk(e) in
  let h0 = hash1(proto_ik) in
  let h1 = mixh(mixh(h0, prol_enc), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k1 = hkk(h0, dhi(e, SR)) in
  let cs = aead(k1, h2, SI) in
  let h3 = mixh(h2, cs) in
  let ck2 = hkck(ck1, dhi(sI, SR)) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  let ma = msg_a(me, them, sid) in
  let cp = aead(k2, h3, ma) in
  let h4 = mixh(h3, cp) in
  event SendMsg(me, them, st_a, ma);
  out(c, (E, cs, cp));
  in(c, (E2: bitstring, cp2: bitstring));
  let h5 = mixh(h4, E2) in
  let ck3 = hkck(ck2, dhi(e, E2)) in
  let k4 = hkk(ck3, dhi(sI, E2)) in
  let mb = unaead(k4, h5, cp2) in
  event RecvMsg(me, them, st_b, mb).

let NoiseRespAB(me: principal, them: principal, sid: sessionid) =
  in(c, (E: bitstring, cs: bitstring, cp: bitstring));
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(proto_ik) in
  let h1 = mixh(mixh(h0, prol_enc), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k1 = hkk(h0, dhr(sR, E)) in
  if unaead(k1, h2, cs) = spub(them) then
  let SI = spub(them) in
  let h3 = mixh(h2, cs) in
  let ck2 = hkck(ck1, dhr(sR, SI)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let ma = unaead(k2, h3, cp) in
  event RecvMsg(me, them, st_a, ma);
  let h4 = mixh(h3, cp) in
  new e: bitstring;
  let E2 = pk(e) in
  let h5 = mixh(h4, E2) in
  let ck3 = hkck(ck2, dhr(e, E)) in
  let k4 = hkk(ck3, dhr(e, SI)) in
  let mb = msg_b(me, them, sid) in
  let cp2 = aead(k4, h5, mb) in
  event SendMsg(me, them, st_b, mb);
  out(c, (E2, cp2)).

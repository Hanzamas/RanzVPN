(* peer-lib.pvl
   The peer layer of a node, as the code has it (AUD-5, #389; docs/formal-model.md; src/Core/Peer.c,
   src/Core/PeerSignal.c). The peer layer has no handshake. A bind to a relay, the bound that answers it, a
   signal that the controller carries and a punch probe are one-shot envelopes sealed with the Noise one-way
   pattern K, Noise_K_25519_AESGCM_SHA256, whose prologue is "ranz peer 1" and the kind of the envelope
   (PeerEnvelopeSeal, PeerEnvelopeOpen). The data datagrams of the peer layer carry their payload in the
   clear: PEER_MSG_DATA, the key of the source, the key of the destination and the payload (PeerSend). The
   only check that stands between a datagram and its delivery is the address that it came from
   (PeerSourcePath) and that its source is a peer (PeerPolicy).

   A datagram reaches a node with the source address that the network gives it, and the attacker is the
   network, so the model sends every datagram with an address, which an honest node sets to its own and the
   attacker sets to what it wants. A relay binds the node of a valid bind to that address
   (PeerInputBind): the model records the address that a bind came from as the one the envelope was opened
   with.

   The receiver of the model keeps no state, so it accepts the replay of an envelope. The code refuses a replay
   by a sequence that must grow (PeerOpenSignal, PeerInputBind, PeerPunchInput), but it keeps the last
   sequence in memory, and drops it with the binding of a relay that expired, with the entry of a peer that
   left the peer table and with a restart of the node: a receiver that has lost it is the receiver of this
   model. While the receiver keeps it, a repeated envelope is PEER_DROP_REPLAY, so the attacker of pe-addr
   drops or outruns the original, and a binding that it takes lasts until the next renewal of the node.

   The kinds of the model (AUD-6, #409): a bind (PeerInputBind at the relay role binds the node to the address
   of the datagram), a signal (PeerOpenSignal; no address), a punch probe (PeerPunchInput sets the direct path
   of the peer to the address that the probe came from, with Config.Punch, which no production code sets) and
   a bound (PeerInputBound at a node takes it only from a configured relay, at the address of that relay, as
   the answer to the last bind of the node). A signal names a relay, which the node takes only when the control
   plane assigned that relay at that address (PEER_DROP_RELAY); the content of a signal is one secret value in
   the model, so that check has no answer of its own here. The relay forwards a data datagram as it came from a
   node bound to it to another node bound to it, inside a VRF of both and under a rate limit, and a node takes a
   datagram with any source key from a relay that it is bound to; the attacker of the model sends any datagram
   from any address, which is all that the forwarding would give it, so the model has no relay process. The
   ICE path (PeerIce.c, libjuice) delivers a datagram through PeerInputDirect only when its source is the peer
   of the ICE session, and its connectivity checks are those of libjuice, which the model does not have.

   No production code runs the peer layer yet: the only PeerNew is the relay role (NodeRelayStart), which
   takes binds and forwards, and nothing in production calls PeerSend, PeerSealSignal, PeerOpenSignal or
   PeerSetRelays. The answers of this model are about the code of the module and its tests.
*)

const name_k: bitstring.
const plabel_peer: bitstring.
const k_bind: bitstring.
const k_signal: bitstring.
const k_punch: bitstring.
const k_bound: bitstring.
const v_peer: bitstring.
const tag_data: bitstring.

(* The network address of a node, public *)
fun addrof(principal): bitstring.

(* The content of an envelope of a kind, and the payload of a data datagram: secret values that the queries
   ask about *)
fun plsecret(principal, principal, bitstring, sessionid): bitstring [private].
fun datasec(principal, principal, sessionid): bitstring [private].

event PeerSealed(principal, principal, bitstring, bitstring, bitstring).
event PeerOpened(principal, principal, bitstring, bitstring, bitstring).
event DataSent(principal, principal, bitstring).
event DataDelivered(principal, principal, bitstring, bitstring).

(* PeerEnvelopeSeal: -> e, es, ss, with the payload that holds the version, a sequence and the content. The
   datagram is sent from the address of the sender. *)
let PeerSeal(me: principal, to: principal, kind: bitstring, sid: sessionid) =
  new e: bitstring;
  new sq: bitstring;
  let sI = skey(me) in
  let SI = pk(sI) in
  let SR = spub(to) in
  let E = pk(e) in
  let pl = (v_peer, sq, plsecret(me, to, kind, sid)) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  let ct = aead(k2, h2, pl) in
  event PeerSealed(me, to, kind, pl, addrof(me));
  out(c, (addrof(me), (kind, SI, E, ct))).

(* PeerEnvelopeOpen: the receiver reads the kind and the key of the sender in the clear, and takes the
   envelope only from a peer that it knows. a is the address that the datagram came from. *)
let PeerOpen(me: principal, them: principal, kind: bitstring) =
  in(c, (a: bitstring, (=kind, SI: bitstring, E: bitstring, ct: bitstring)));
  if SI = spub(them) then
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let pl = unaead(k2, h2, ct) in
  event PeerOpened(me, them, kind, pl, a).

(* PeerInputBound: a node takes a bound only from the relay that it has configured, at the address of that relay *)
let PeerOpenBound(me: principal, relay: principal) =
  in(c, (a: bitstring, (=k_bound, SI: bitstring, E: bitstring, ct: bitstring)));
  if a = addrof(relay) then
  if SI = spub(relay) then
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, k_bound)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let pl = unaead(k2, h2, ct) in
  event PeerOpened(me, relay, k_bound, pl, a).

(* PeerSend and PeerInputData: a data datagram in the clear, taken from the address of the peer *)
let DataSend(me: principal, to: principal, sid: sessionid) =
  let d = datasec(me, to, sid) in
  event DataSent(me, to, d);
  out(c, (addrof(me), (tag_data, spub(me), spub(to), d))).

let DataRecv(me: principal, them: principal) =
  in(c, (a: bitstring, (=tag_data, src: bitstring, dst: bitstring, d: bitstring)));
  if a = addrof(them) then
  if src = spub(them) then
  if dst = spub(me) then
  event DataDelivered(me, them, d, a).

let PeerSetup() =
  out(c, spub(alice));
  out(c, spub(bob));
  out(c, spub(charlie));
  out(c, skey(charlie)).

let PeerLeaks(me: principal) =
  ( event LeakS(phase0, me); out(c, skey(me)) )
  | ( phase 1; event LeakS(phase1, me); out(c, skey(me)) ).

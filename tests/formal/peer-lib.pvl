(* peer-lib.pvl
   The peer layer of a node, as the code has it (AUD-5, #389; AUD-6, #409; CORE-H2, #399; docs/formal-model.md;
   src/Core/Peer.c, src/Core/PeerSignal.c, src/Core/PeerSession.c, src/Core/PeerChallenge.c, src/Core/PeerPunch.c).
   A bind to a relay, the bound that answers it, the challenge of a relay, a signal that the controller carries and a
   punch message are one-shot envelopes sealed with the Noise one-way pattern K, Noise_K_25519_AESGCM_SHA256, whose
   prologue is "ranz peer 1" and the kind of the envelope (PeerEnvelopeSeal, PeerEnvelopeOpen). The data datagrams
   go in a peer session (PeerSession.c): Noise_IK_25519_AESGCM_SHA256 between the static keys of the two nodes, with
   the prologue "ranz peer session 1", and records under the keys of its Split. A datagram of the session keeps a
   clear header, its kind, the key of the source and the key of the destination, which a record has as its
   associated data; the record of the model is the first one of the initiator.

   A datagram reaches a node with the source address that the network gives it, and the attacker is the network, so
   the model sends every datagram with an address, which an honest node sets to its own and the attacker sets to
   what it wants. A relay binds a node only when its bind holds the cookie of the address that the bind came from
   (PeerInputBind, PeerCookieCheck): an HMAC under a secret of the relay, which the relay sends to that address in a
   challenge sealed to the node (PeerChallengeSend). A bind without the cookie draws the challenge. The node answers
   a challenge from its relay for its last bind with a bind that carries the cookie (PeerInputChallenge).

   The receiver of the model keeps no state, so it accepts the replay of an envelope. The code refuses a replay by a
   sequence that must grow (PeerOpenSignal, PeerInputBind, PeerPunchInput, PeerSessionTakeInit), above the clock when
   the receiver made its entry of the peer (PeerFloorOf), so a receiver that lost the last sequence by the expiry of
   a binding, a change of the peer list or a restart still refuses what was sealed before. Time is not in the model,
   so its receiver is one that takes any sequence.

   The kinds of the model: a bind and its challenge (the relay process RelayBind and the node process NodeBind, and
   the bind of PeerSeal with a payload that no relay takes), a signal (PeerOpenSignal; no address), a punch message,
   a bound (PeerInputBound at a node takes it only from a configured relay, at the address of that relay, as the
   answer to the last bind of the node), and the handshake messages and the record of a peer session. A probe of a
   punch (PeerSeal of k_punch) moves no peer to a direct path: of the two ends, the one with the lower key (bob here)
   leads; it sends a challenge with a nonce to the address of a probe, the other end answers with a response that
   echoes it and holds a nonce of its own, and the leader sends a proof that echoes that; each end moves the peer to
   the direct path at the address that its nonce went to, once the echo came from there (PunchLead, PunchFollow). A
   signal names a relay, which the node takes only when the control plane assigned that relay at that address
   (PEER_DROP_RELAY); the content of a signal is one secret value in the model, so that check has no answer of its own
   here. The relay forwards a datagram of a session as it came from a node bound to it to another node bound to it,
   inside a VRF of both and under a rate limit; the attacker of the model sends any datagram from any address, which
   is all that the forwarding would give it, so the model has no forwarding process. The ICE path (PeerIce.c,
   libjuice) takes a datagram only from the peer's address on the pair that the ICE session validated, and only when
   its source is the peer of the ICE session, and its connectivity checks are those of libjuice, which the model does
   not have.

   No production code runs the peer layer yet: the only PeerNew is the relay role (NodeRelayStart), which takes binds
   and forwards, and nothing in production calls PeerSend, PeerSealSignal, PeerOpenSignal or PeerSetRelays. The
   answers of this model are about the code of the module and its tests.

   A process makes its fresh values (ephemeral keys, sequences, nonces) before its first input, where the code makes
   them when it sends. A fresh value is as fresh either way; a name made after an input carries that input in
   ProVerif, and with the leaked keys of peer-leaks the attacker nests such names without end (#399).
*)

const name_k: bitstring.
const name_ik: bitstring.
const plabel_peer: bitstring.
const plabel_sess: bitstring.
const k_bind: bitstring.
const k_signal: bitstring.
const k_punch: bitstring.
const k_bound: bitstring.
const k_challenge: bitstring.
const k_init: bitstring.
const k_response: bitstring.
const k_record: bitstring.
const v_peer: bitstring.
const pt_challenge: bitstring.
const pt_response: bitstring.
const pt_proof: bitstring.

(* The network address of a node, public *)
fun addrof(principal): bitstring.

(* The secret of the bind challenges of a relay, new at every start of the relay and never sent *)
fun cookiekey(principal): bitstring [private].

(* The content of an envelope of a kind, and the payload of a data datagram: secret values that the queries
   ask about *)
fun plsecret(principal, principal, bitstring, sessionid): bitstring [private].
fun datasec(principal, principal, sessionid): bitstring [private].

event PeerSealed(principal, principal, bitstring, bitstring, bitstring).
(* The one-shot envelope of PeerSeal, which takes no input before it seals: the event of the injective query pe-replay.
   An injective query keeps, for each event of its conclusion, the inputs that came before it; the seals of the bind
   with its cookie and of the punch come after inputs that the attacker of peer-leaks builds from leaked keys, and
   ProVerif did not end on PeerSealed there (#399). *)
event EnvelopeSealed(principal, principal, bitstring, bitstring).
event PeerOpened(principal, principal, bitstring, bitstring, bitstring).
event DataSent(principal, principal, bitstring).
event DataDelivered(principal, principal, bitstring, bitstring).
event ChallengeSent(principal, principal, bitstring, bitstring).
event BindCookie(principal, principal, bitstring).
event RelayBound(principal, principal, bitstring, bitstring).
event PunchNonce(principal, principal, bitstring, bitstring).
event PunchEcho(principal, principal, bitstring).
event PunchDirect(principal, principal, bitstring, bitstring).

(* PeerEnvelopeSeal as a term: -> e, es, ss with the payload pl, from the static scalar sI to the static key SR *)
letfun kseal(sI: bitstring, SR: bitstring, kind: bitstring, e: bitstring, pl: bitstring) =
  let SI = pk(sI) in
  let E = pk(e) in
  let h0 = hash1(name_k) in
  let h2 = mixh(mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR), E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  (kind, SI, E, aead(k2, h2, pl)).

(* PeerEnvelopeOpen as a term: the payload of the envelope from the static key SI to the static scalar sR *)
letfun kopen(sR: bitstring, SI: bitstring, kind: bitstring, E: bitstring, ct: bitstring) =
  let SR = pk(sR) in
  let h0 = hash1(name_k) in
  let h2 = mixh(mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR), E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  unaead(k2, h2, ct).

(* PeerEnvelopeSeal: -> e, es, ss, with the payload that holds the version, a sequence and the content. The
   datagram is sent from the address of the sender. *)
let PeerSeal(me: principal, to: principal, kind: bitstring, sid: sessionid) =
  new e: bitstring;
  new sq: bitstring;
  let sI = skey(me) in
  let SI = pk(sI) in
  let SR = spub(to) in
  let E = pk(e) in
  let pl = (v_peer, sq, plsecret(me, to, kind, sid)) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  let ct = aead(k2, h2, pl) in
  event PeerSealed(me, to, kind, pl, addrof(me));
  event EnvelopeSealed(me, to, kind, pl);
  out(c, (addrof(me), (kind, SI, E, ct))).

(* PeerEnvelopeOpen: the receiver reads the kind and the key of the sender in the clear, and takes the
   envelope only from a peer that it knows. a is the address that the datagram came from. *)
let PeerOpen(me: principal, them: principal, kind: bitstring) =
  in(c, (a: bitstring, (=kind, SI: bitstring, E: bitstring, ct: bitstring)));
  if SI = spub(them) then
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, kind)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let pl = unaead(k2, h2, ct) in
  event PeerOpened(me, them, kind, pl, a).

(* PeerInputBound: a node takes a bound only from the relay that it has configured, at the address of that relay *)
let PeerOpenBound(me: principal, relay: principal) =
  in(c, (a: bitstring, (=k_bound, SI: bitstring, E: bitstring, ct: bitstring)));
  if a = addrof(relay) then
  if SI = spub(relay) then
  let sR = skey(me) in
  let SR = pk(sR) in
  let h0 = hash1(name_k) in
  let h1 = mixh(mixh(mixh(h0, (plabel_peer, k_bound)), SI), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let pl = unaead(k2, h2, ct) in
  event PeerOpened(me, relay, k_bound, pl, a).

(* PeerChallengeSend: the relay me answers a bind of the node them from the address a with the cookie of that
   address, sealed to the node and sent to that address *)
let RelayChallenge(me: principal, them: principal, a: bitstring, sq: bitstring, ck: bitstring, e: bitstring) =
  let pl = (v_peer, sq, ck) in
  event ChallengeSent(me, them, a, ck);
  event PeerSealed(me, them, k_challenge, pl, addrof(me));
  out(c, (addrof(me), kseal(skey(me), spub(them), k_challenge, e, pl))).

(* PeerInputBind at the relay role: a bind of the node them from the address a binds it there only with the cookie
   of a; a bind without a cookie, or with another, draws the challenge *)
let RelayBind(me: principal, them: principal) =
  new e: bitstring;
  in(c, (a: bitstring, (=k_bind, SI: bitstring, E: bitstring, ct: bitstring)));
  if SI = spub(them) then
  let pl = kopen(skey(me), SI, k_bind, E, ct) in
  let ck = hmac(cookiekey(me), (SI, a)) in
  let (=v_peer, sq: bitstring, =ck) = pl in
    event RelayBound(me, them, a, ck)
  else let (=v_peer, sq1: bitstring) = pl in
    RelayChallenge(me, them, a, sq1, ck, e)
  else let (=v_peer, sq2: bitstring, other: bitstring) = pl in
    RelayChallenge(me, them, a, sq2, ck, e).

(* PeerBind and PeerInputChallenge at the node me: a bind with no cookie, then, for the challenge of its relay to that
   bind, a bind with the cookie of the challenge *)
let NodeBind(me: principal, relay: principal) =
  new sq: bitstring;
  new e: bitstring;
  new sq2: bitstring;
  new e2: bitstring;
  let pl = (v_peer, sq) in
  event PeerSealed(me, relay, k_bind, pl, addrof(me));
  out(c, (addrof(me), kseal(skey(me), spub(relay), k_bind, e, pl)));
  in(c, (a: bitstring, (=k_challenge, SR: bitstring, E: bitstring, ct: bitstring)));
  if a = addrof(relay) then
  if SR = spub(relay) then
  let (=v_peer, =sq, ck: bitstring) = kopen(skey(me), SR, k_challenge, E, ct) in
  let pl2 = (v_peer, sq2, ck) in
  event BindCookie(me, relay, ck);
  event PeerSealed(me, relay, k_bind, pl2, addrof(me));
  out(c, (addrof(me), kseal(skey(me), SR, k_bind, e2, pl2))).

(* The initiator of a peer session (PeerSessionWriteInit, PeerSessionTakeResponse, PeerSessionWriteRecord): the
   initiation -> e, es, s, ss with a timestamp, the response <- e, ee, se, and the first record under the key of
   Split, with the clear header as its associated data *)
let PeerSessInit(me: principal, them: principal, sid: sessionid) =
  new e: bitstring;
  new ts: bitstring;
  let sI = skey(me) in
  let SI = pk(sI) in
  let SR = spub(them) in
  let E = pk(e) in
  let h0 = hash1(name_ik) in
  let h1 = mixh(mixh(h0, plabel_sess), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhi(e, SR)) in
  let k1 = hkk(h0, dhi(e, SR)) in
  let cs = aead(k1, h2, SI) in
  let h3 = mixh(h2, cs) in
  let ck2 = hkck(ck1, dhi(sI, SR)) in
  let k2 = hkk(ck1, dhi(sI, SR)) in
  let cp = aead(k2, h3, ts) in
  let h4 = mixh(h3, cp) in
  out(c, (addrof(me), (k_init, SI, SR, E, cs, cp)));
  in(c, (a: bitstring, (=k_response, =SR, =SI, E2: bitstring, cp2: bitstring)));
  let h5 = mixh(h4, E2) in
  let ck3 = hkck(ck2, dhi(e, E2)) in
  let ck4 = hkck(ck3, dhi(sI, E2)) in
  let k4 = hkk(ck3, dhi(sI, E2)) in
  let pr = unaead(k4, h5, cp2) in
  let ki = hksplit1(ck4) in
  let d = datasec(me, them, sid) in
  event DataSent(me, them, d);
  out(c, (addrof(me), (k_record, SI, SR, aead(ki, (k_record, SI, SR), d)))).

(* The responder of a peer session (PeerSessionTakeInit, PeerSessionTakeRecord): it takes an initiation whose
   static key is the one of the peer that the clear header names, answers it, and delivers a record under the key
   of Split whose clear header names the same two keys *)
let PeerSessResp(me: principal, them: principal) =
  new e: bitstring;
  in(c, (a: bitstring, (=k_init, SI: bitstring, SR: bitstring, E: bitstring, cs: bitstring, cp: bitstring)));
  let sR = skey(me) in
  if SR = pk(sR) then
  if SI = spub(them) then
  let h0 = hash1(name_ik) in
  let h1 = mixh(mixh(h0, plabel_sess), SR) in
  let h2 = mixh(h1, E) in
  let ck1 = hkck(h0, dhr(sR, E)) in
  let k1 = hkk(h0, dhr(sR, E)) in
  if unaead(k1, h2, cs) = SI then
  let h3 = mixh(h2, cs) in
  let ck2 = hkck(ck1, dhr(sR, SI)) in
  let k2 = hkk(ck1, dhr(sR, SI)) in
  let ts = unaead(k2, h3, cp) in
  let h4 = mixh(h3, cp) in
  let E2 = pk(e) in
  let h5 = mixh(h4, E2) in
  let ck3 = hkck(ck2, dhr(e, E)) in
  let ck4 = hkck(ck3, dhr(e, SI)) in
  let k4 = hkk(ck3, dhr(e, SI)) in
  out(c, (addrof(me), (k_response, SR, SI, E2, aead(k4, h5, empty))));
  let ki = hksplit1(ck4) in
  in(c, (a2: bitstring, (=k_record, =SI, =SR, ct: bitstring)));
  let d = unaead(ki, (k_record, SI, SR), ct) in
  event DataDelivered(me, them, d, a2).

(* PeerPunchInput at the end with the lower key: a challenge with a nonce to the address a of a probe, sealed to the
   peer; the direct path at a once a response from a echoes the nonce, and a proof that echoes the peer's nonce *)
let PunchLead(me: principal, them: principal) =
  new n: bitstring;
  new e: bitstring;
  new sq: bitstring;
  new e2: bitstring;
  new sq3: bitstring;
  in(c, a: bitstring);
  let pl = (v_peer, sq, pt_challenge, n, empty) in
  event PunchNonce(me, them, a, n);
  event PeerSealed(me, them, k_punch, pl, addrof(me));
  out(c, (addrof(me), kseal(skey(me), spub(them), k_punch, e, pl)));
  in(c, (a2: bitstring, (=k_punch, SI: bitstring, E: bitstring, ct: bitstring)));
  if SI = spub(them) then
  if a2 = a then
  let (=v_peer, sq2: bitstring, =pt_response, m: bitstring, =n) = kopen(skey(me), SI, k_punch, E, ct) in
  event PunchDirect(me, them, a, n);
  let pl2 = (v_peer, sq3, pt_proof, empty, m) in
  event PunchEcho(me, them, m);
  event PeerSealed(me, them, k_punch, pl2, addrof(me));
  out(c, (addrof(me), kseal(skey(me), SI, k_punch, e2, pl2))).

(* PeerPunchInput at the other end: a challenge from the address a draws a response to a that echoes its nonce and
   holds one of its own; the direct path at a once a proof from a echoes that *)
let PunchFollow(me: principal, them: principal) =
  new m: bitstring;
  new e: bitstring;
  new sq2: bitstring;
  in(c, (a: bitstring, (=k_punch, SI: bitstring, E: bitstring, ct: bitstring)));
  if SI = spub(them) then
  let (=v_peer, sq: bitstring, =pt_challenge, n: bitstring, x: bitstring) = kopen(skey(me), SI, k_punch, E, ct) in
  let pl = (v_peer, sq2, pt_response, m, n) in
  event PunchEcho(me, them, n);
  event PunchNonce(me, them, a, m);
  event PeerSealed(me, them, k_punch, pl, addrof(me));
  out(c, (addrof(me), kseal(skey(me), SI, k_punch, e, pl)));
  in(c, (a2: bitstring, (=k_punch, SI2: bitstring, E2: bitstring, ct2: bitstring)));
  if SI2 = spub(them) then
  if a2 = a then
  let (=v_peer, sq3: bitstring, =pt_proof, y: bitstring, =m) = kopen(skey(me), SI2, k_punch, E2, ct2) in
  event PunchDirect(me, them, a, m).

let PeerSetup() =
  out(c, spub(alice));
  out(c, spub(bob));
  out(c, spub(charlie));
  out(c, skey(charlie)).

let PeerLeaks(me: principal) =
  ( event LeakS(phase0, me); out(c, skey(me)) )
  | ( phase 1; event LeakS(phase1, me); out(c, skey(me)) ).

(* Variant tunnel-quic-cert: a further connection joins a tunnel over QUIC, as the code has it, against an attacker that
   holds the key of the certificate of the server (AUD-5, #389; AUD-6, #409; CORE-H5, #408). The binding is the TLS
   exporter of each QUIC connection (TransportQuicExporter), so the middlebox cannot relay the join of alice to bob over
   a session of its own, as on TLS-443 (tunnel-cert): finding F1 is closed for a join. The static key still decides
   which Tunnel a connection joins. *)

process
  ( Setup()
  | LeakCertServer()
  | !( TunnelOpen(bob, alice) )
  | !( TunnelOpen(bob, charlie) )
  | !( JoinClient(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( JoinServer(bob, bt_export, plabel_session, lab_exp_session, suite_hfs, kc_on) )
  )

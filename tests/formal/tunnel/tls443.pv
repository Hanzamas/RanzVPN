(* Variant tunnel: a further connection joins a tunnel over TLS 1.3 on TCP 443, as the code has it (AUD-5, #389).
   alice has a Tunnel with bob and joins connections to it, each in an outer session of its own with the pinned
   certificate and the binding to its exporter. charlie, whose keys the attacker holds, has a Tunnel of his own
   and may dial bob with any id that he knows, which is every id. The server compares the static key of a joining
   connection with the one of the Tunnel (NoiseTunnelJoin). The keys of alice and bob and the key of the
   certificate of bob are leaked in phase 0 and in phase 1, as in tls443. *)

process
  ( Setup()
  | Leaks()
  | !( TunnelOpen(bob, alice) )
  | !( TunnelOpen(bob, charlie) )
  | !( JoinClient(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( JoinServer(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, suite_hfs, kc_on) )
  | !( JoinServer(bob, charlie, bt_export, plabel_session, lab_exp_session, suite_ik, suite_hfs, kc_on) )
  )

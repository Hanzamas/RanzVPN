(* Variant tunnel-nokey, a negative control: the server joins a connection to the Tunnel of the id that it names
   without comparing its static key with the one of the Tunnel (NoiseTunnelJoin does compare them). charlie then
   joins the Tunnel of alice with her id, which the attacker knows, and the model must show that attack (AUD-5,
   #389). The outer session and the keys are as in tunnel. *)

process
  ( Setup()
  | Leaks()
  | !( TunnelOpen(bob, alice) )
  | !( TunnelOpen(bob, charlie) )
  | !( JoinClient(alice, bob, pin_on, bt_export, plabel_session, lab_exp_session, suite_hfs) )
  | !( JoinServer(bob, alice, bt_export, plabel_session, lab_exp_session, suite_ik, suite_hfs, kc_off) )
  | !( JoinServer(bob, charlie, bt_export, plabel_session, lab_exp_session, suite_ik, suite_hfs, kc_off) )
  )

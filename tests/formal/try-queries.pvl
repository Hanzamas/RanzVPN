(* try-queries.pvl: a try (AUD-5, #389). Three queries of session-queries.pvl, to compare settings of the prover. *)

(* @query sec-pw-unless-both *)
query attacker(pw(alice)) ==> event(LeakS(phase0, bob)) && event(LeakCert(phase0, bob)).

(* @query auth-server *)
query t: bitstring; event(ServerAccept(bob, alice, t)) ==> event(ClientStart(alice, bob, t)) || event(LeakS(phase0, alice)) || event(LeakS(phase0, bob)).

(* @query data-auth *)
query t: bitstring, d: bitstring; event(ClientGotData(alice, bob, t, d)) ==> event(ServerSentData(bob, alice, t, d)) || event(LeakS(phase0, bob)).

(* try-stage-a-queries.pvl: a try (AUD-5, #389). Queries of the first message of Noise_IK. *)

(* @query reach-a *)
query m: bitstring; event(RecvMsg(bob, alice, st_a, m)).

(* @query a-auth2 *)
query cc: principal, m: bitstring; event(RecvMsg(bob, alice, st_a, m)) ==> event(SendMsg(alice, cc, st_a, m)) || event(LeakS(phase0, alice)).

(* @query a-conf2 *)
query sid: sessionid, px: phasen; attacker(msg_a(alice, bob, sid)) ==> event(LeakS(px, bob)).

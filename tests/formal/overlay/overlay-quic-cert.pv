(* Variant overlay-quic-cert: an overlay session over QUIC, against an attacker that holds the key of the certificate of
   the server (AUD-6, #409; CORE-H5, #408). The TLS exporter of the QUIC connection binds the handshake to the
   connection (TransportQuicExporter), so the overlay sessions that run in production keep the middlebox out, as on
   TLS-443 (overlay-tls443-cert): finding F1 is closed for them too. *)

process
  ( Setup()
  | LeakCertServer()
  | OverlaySessions(pin_on, bt_export)
  )

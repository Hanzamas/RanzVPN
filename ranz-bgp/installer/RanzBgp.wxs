<?xml version="1.0" encoding="utf-8"?>
<!--
  The RanzBgp feature of the MSI (WiX v5; ADR-0010, ADR-0022, CORE-S7-1 #82): ranz-bgp.exe, the BGP sidecar of the
  node, and the licence of GoBGP, which ranz-bgp embeds (Apache-2.0, section 4 asks for a copy with the binary).

  The feature is optional. Its Level of 1000 is above the INSTALLLEVEL of 1 that a default install has, so a node
  installed without a choice carries no sidecar, and only the nodes that peer with routers carry it: they are
  installed with ADDLOCAL=RanzBgp (or the feature is added later in a maintenance install). The node starts the
  sidecar only when its configuration names BGP peers (src/Cedar/NodeBgp.c).

  A package takes the feature with <FeatureRef Id="RanzBgp" /> and defines INSTALLFOLDER, the folder of
  ranz-node.exe: the node looks for ranz-bgp.exe next to its own executable. The preprocessor variables name the
  files: RanzBgpExe (ranz-bgp.exe, built for the architecture of the package) and GoBgpLicense (the LICENSE file
  of the GoBGP module that ranz-bgp/go.mod pins).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Feature Id="RanzBgp" Title="BGP peering (ranz-bgp)" Description="The BGP sidecar for nodes that peer with the operator's own routers." Level="1000" AllowAbsent="yes">
      <ComponentGroupRef Id="RanzBgpFiles" />
    </Feature>

    <ComponentGroup Id="RanzBgpFiles" Directory="INSTALLFOLDER">
      <Component Id="RanzBgpExe">
        <File Id="RanzBgpExe" Source="$(var.RanzBgpExe)" Name="ranz-bgp.exe" KeyPath="yes" />
      </Component>
      <Component Id="RanzBgpGoBgpLicense">
        <File Id="RanzBgpGoBgpLicense" Source="$(var.GoBgpLicense)" Name="ranz-bgp-GoBGP-LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

# A node that opens its stream from an address outside the source prefixes of a Network of its
# VRFs (Network corp-lan lists documentation addresses, and the node comes from loopback) is
# refused, naming the address and the Network, and receives nothing of its state.
refuse: {
  reason: REFUSE_REASON_UNKNOWN_NODE
  message: "the source address 127.0.0.1 is outside the source prefixes that Network \"corp-lan\" allows to enrol"
}

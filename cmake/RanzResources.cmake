# RanzResources.cmake
# The hamcore files (src/bin/hamcore) as resources of the executables (#89).
#
# ranz_hamcore_resources(<target>) gives <target> a generated resource script that holds every
# file of src/bin/hamcore as a resource of type HAMCORE, and an index of them, the resource
# HAMCORE "INDEX": the path of each file relative to src/bin/hamcore, with "/" between folders,
# one per line. The file on line n of the index is the resource with the integer ID n.
# FileIO.c reads them (ReadHamcore and the "|" prefix of the file functions); the type and the
# index name here are HAMCORE_RESOURCE_TYPE and HAMCORE_RESOURCE_INDEX of FileIO.h.
#
# The files are listed at configure time. CONFIGURE_DEPENDS runs CMake again when a file is
# added or removed, and OBJECT_DEPENDS compiles the script again when a file changes (the
# resource compiler's dependency scan sees #include only, not the files a resource names).

set(RANZ_HAMCORE_DIR "${TOP_DIRECTORY}/src/bin/hamcore")

# Writes <content> to <path> unless the file already holds it, so that an unchanged file keeps
# its time stamp and nothing is compiled again
function(ranz_write_if_changed path content)
  if(EXISTS "${path}")
    file(READ "${path}" _ranz_old)
    if(_ranz_old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

function(ranz_hamcore_resources target)
  file(GLOB_RECURSE _ranz_files LIST_DIRECTORIES false RELATIVE "${RANZ_HAMCORE_DIR}"
    CONFIGURE_DEPENDS "${RANZ_HAMCORE_DIR}/*")
  list(SORT _ranz_files)
  if(NOT _ranz_files)
    message(FATAL_ERROR "ranz_hamcore_resources: no files in ${RANZ_HAMCORE_DIR}")
  endif()

  set(_ranz_index_path "${CMAKE_CURRENT_BINARY_DIR}/hamcore_index.txt")
  set(_ranz_rc_path "${CMAKE_CURRENT_BINARY_DIR}/hamcore.rc")

  set(_ranz_index "")
  set(_ranz_rc "// Generated by cmake/RanzResources.cmake from src/bin/hamcore\n#pragma code_page(65001)\n")
  set(_ranz_deps "${_ranz_index_path}")
  set(_ranz_id 0)
  foreach(_ranz_file IN LISTS _ranz_files)
    # The name goes into a line of the index and into a quoted string of the script
    if(_ranz_file MATCHES "[^A-Za-z0-9_./-]")
      message(FATAL_ERROR "ranz_hamcore_resources: ${RANZ_HAMCORE_DIR}/${_ranz_file}: "
        "a file name may hold letters, digits, '_', '.', '-' and '/' only")
    endif()
    math(EXPR _ranz_id "${_ranz_id} + 1")
    string(APPEND _ranz_index "${_ranz_file}\n")
    string(APPEND _ranz_rc "${_ranz_id} HAMCORE \"${RANZ_HAMCORE_DIR}/${_ranz_file}\"\n")
    list(APPEND _ranz_deps "${RANZ_HAMCORE_DIR}/${_ranz_file}")
  endforeach()
  string(APPEND _ranz_rc "INDEX HAMCORE \"${_ranz_index_path}\"\n")

  ranz_write_if_changed("${_ranz_index_path}" "${_ranz_index}")
  ranz_write_if_changed("${_ranz_rc_path}" "${_ranz_rc}")

  target_sources(${target} PRIVATE "${_ranz_rc_path}")
  set_source_files_properties("${_ranz_rc_path}" PROPERTIES OBJECT_DEPENDS "${_ranz_deps}")
endfunction()
